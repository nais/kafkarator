FROM golang:1.26 AS builder

ENV CGO_ENABLED=0

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -installsuffix cgo -o canary-deployer cmd/canary-deployer/*.go

FROM cgr.dev/chainguard/static:latest

WORKDIR /
COPY --from=builder /workspace/canary-deployer /
ENTRYPOINT ["/canary-deployer"]
