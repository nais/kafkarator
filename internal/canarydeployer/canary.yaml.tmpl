---
kind: Application
apiVersion: nais.io/v1alpha1
metadata:
  name: kafka-canary
  namespace: "{{ .Team }}"
  labels:
    team: "{{ .Team }}"
spec:
  replicas:
    min: 2
    max: 2
  image: "{{ .Image }}"
  kafka:
    pool: "{{ .Pool }}"
  prometheus:
    enabled: true
    path: /metrics
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
  env:
    - name: CANARY_DEPLOY_START_TIME
      value: "{{ .Now }}"
    - name: CANARY_MESSAGE_INTERVAL
      value: 5s
    - name: CANARY_KAFKA_TOPIC
      value: "{{ .CanaryKafkaTopic }}"
    - name: CANARY_KAFKA_TX_TOPIC
      value: "{{ .CanaryKafkaTxTopic }}"
    - name: CANARY_ENABLE_TRANSACTION
      value: "{{ .CanaryEnableTransaction }}"
    - name: CANARY_KAFKA_GROUP_ID
      value: "{{ .GroupID }}"
    - name: CANARY_LOG_FORMAT
      value: json
    - name: CANARY_METRICS_ADDRESS
      value: 0.0.0.0:8080
